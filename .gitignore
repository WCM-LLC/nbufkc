# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but always commit the documented template:
!.env.example

# vercel
.vercel

# TinaCMS
# /public/admin is the compiled visual editor (output of `tinacms build`) — regenerated every build.
/public/admin
# These two files are regenerated by `tinacms build`/`tinacms dev` on every run.
tina/__generated__/client.ts
tina/__generated__/types.ts
# NOTE: the rest of tina/__generated__ (tina-lock.json, *.gql, _graphql.json, _schema.json)
# IS committed — Tina Cloud reads the schema lock from the repo.

# typescript
*.tsbuildinfo
next-env.d.ts
