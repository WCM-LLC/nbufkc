# ─────────────────────────────────────────────────────────────
# NBUF-KC website — environment variables
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# Never commit real secrets. In production, set these in Vercel
# (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ---- TinaCMS / Tina Cloud (visual editing) ----
# Get these after creating a project at https://app.tina.io
# (Tina Cloud → your project → Overview / Tokens).
NEXT_PUBLIC_TINA_CLIENT_ID=78793f73-e673-45d4-ac6f-fb12cc7f0ce1
TINA_TOKEN=44210fd04bdf60c2431a6684f9f9db46acd2f7bf
# The git branch Tina reads/writes. Usually "main".
NEXT_PUBLIC_TINA_BRANCH=main

# ---- Contact form email (Resend) ----
# Create an API key at https://resend.com (Dashboard → API Keys).
RESEND_API_KEY=
# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=
# The "from" address. Must be on a domain you've verified in Resend.
# Until you verify a domain, you can use Resend's sandbox: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# ---- Site URL (used for SEO: canonical URLs, sitemap, Open Graph) ----
# In production set this to your real domain, e.g. https://nbufkc.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000
